# Copy to .env locally; never commit .env. Docker Compose reads the root file.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
AUTH_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
ALLOW_DEMO_GUEST=true
DEVELOPMENT_VERIFICATION_CODES=false
DEMO_MODE=true
VLM_BACKEND=demo

# Set only in backend/.env when running without Docker. Omit to use local SQLite.
# DATABASE_URL=postgresql+psycopg://satquery:password@localhost:5432/satquery
# UPLOAD_DIR=./data/uploads

# Configure real delivery and identity providers when ready.
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Satquery AI <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OPENROUTER_API_KEY=

# Public deployment requires:
# ENVIRONMENT=production
# COOKIE_SECURE=true
# ALLOW_DEMO_GUEST=false
# DEVELOPMENT_VERIFICATION_CODES=false
# CORS_ORIGINS=https://your-domain.example
# Keep DEMO_MODE=true if you want the clearly labelled demo consoles available.
